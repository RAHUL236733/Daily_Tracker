# Backend Production Environment Variables
# Copy this to .env on Render dashboard or local production testing

# ============= ENVIRONMENT =============
NODE_ENV=production

# ============= DATABASE =============
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/dailytracker?retryWrites=true&w=majority

# ============= FRONTEND URL =============
# This is crucial for CORS to work correctly
FRONTEND_URL=https://daily-tracker-mu-five.vercel.app

# ============= JWT AUTHENTICATION =============
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-character-hex-secret-here-change-in-production-12345678901234
JWT_REFRESH_SECRET=another-32-character-hex-secret-for-refresh-tokens-987654321098765432
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# ============= COOKIE CONFIGURATION =============
# For cross-domain cookies (Vercel frontend to Render backend)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=  # Leave empty for cross-domain, Render/Vercel handle it

# ============= EMAIL SERVICE (Nodemailer) =============
# Using Gmail with App Password (recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# Generate app password: https://support.google.com/accounts/answer/185833
EMAIL_PASSWORD=your-16-character-app-password-here

# Alternative: Using SendGrid, AWS SES, or custom SMTP
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=SG.your-sendgrid-api-key

# ============= RATE LIMITING =============
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# ============= PORT =============
# Render will set this automatically, but include for clarity
PORT=5000

# ============= OPTIONAL: LOGGING =============
# LOG_LEVEL=debug  # debug, info, warn, error
